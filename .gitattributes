# Les fixtures Winamax sont des exports reels : LF sans BOM, verifie (docs/formats/winamax.md §3).
# Le parser recherche des sequences "\n\n\n" litterales (PAR-3) : ne jamais laisser
# git les reecrire en CRLF au checkout (comportement par defaut de core.autocrlf=true
# sur les runners Windows, y compris GitHub Actions windows-latest).
fixtures/**/*.txt text eol=lf

# Snapshots insta : generes et compares tels quels par `cargo test` (comparaison
# de chaines exactes). Meme piege CRLF que les fixtures si on laisse core.autocrlf
# les reecrire au checkout sur un runner Windows.
*.snap text eol=lf

# Migrations gr-store : leur contenu est embarque via `include_str!` et hache
# (schema_migrations.checksum, R-SCHEMA) pour detecter une modification
# apres merge. Meme piege CRLF que les fixtures/snapshots ci-dessus : sans
# `eol=lf`, une simple recompilation apres un checkout Windows suffit a
# changer les octets embarques et declencher un faux positif "migration
# deja appliquee avec un contenu different" (`gr_store::migrate`).
crates/gr-store/migrations/*.sql text eol=lf
